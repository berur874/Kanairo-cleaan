PORT=5050
DB_HOST=localhost
DB_USER=root
DB_PASSWORD=change-me
DB_NAME=kanairo
# Partner API keys: one per consumer, as name:key pairs separated by commas. Generate each key with
#   node -e "console.log(require('crypto').randomBytes(24).toString('hex'))"
# Remove a consumer's pair and restart to revoke only their key.
API_KEYS=group1:change-me-long-random-key,team13:change-me-another-long-random-key

# Code a hub manager must enter to sign up. Leave empty to switch hub manager sign-up off.
HUB_INVITE_CODE=

# Optional rate limits (requests per window). Defaults: 300/min per IP, 100/min per partner key,
# 20 log-in/sign-up attempts per 15 min per IP.
# IP_RATE_LIMIT=300
# PARTNER_RATE_LIMIT=100
# AUTH_RATE_LIMIT=20

# Week 10: upstream partner (Group 12, AccessMap Nairobi). Leave the key empty until they issue one.
PARTNER_URL=https://partner-url-here
PARTNER_API_KEY=
